{
  "name": "pw-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=mobile-android --project=mobile-ios",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "test:booker": "playwright test --project=api-booker",
    "test:a11y": "playwright test --grep @a11y --project=ui-chromium",
    "bdd": "bddgen && playwright test --project=bdd",
    "bdd:smoke": "bddgen && playwright test --project=bdd --grep @smoke",
    "test:contract": "playwright test --project=contract-provider",
    "test:healing": "playwright test --grep @healing --project=ui-chromium",
    "test:heal": "HEAL_MODE=heal playwright test --project=ui-chromium",
    "heal:report": "node scripts/healing-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@axe-core/playwright": "^4.14.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "playwright-bdd": "^9.2.1"
  }
}
